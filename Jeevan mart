/* =========================
   REGISTER
========================= */

void registerUser() {

    cout << "\n====================================\n";
    cout << "       JEEVAN_MART REGISTER\n";
    cout << "====================================\n";

    cin.ignore(numeric_limits<streamsize>::max(), '\n');

    cout << "Enter your name: ";
    getline(cin, user.name);

    cout << "Enter email: ";
    getline(cin, user.email);

    cout << "Enter phone number: ";
    getline(cin, user.phone);

    cout << "Create password: ";
    getline(cin, user.password);

    if (user.password.length() < 6) {
        cout << "\nPassword must contain at least 6 characters.\n";
        return;
    }

    registered = true;

    cout << "\nAccount created successfully! 🎉\n";
}


/* =========================
   LOGIN
========================= */

bool loginUser() {

    if (!registered) {

        cout << "\nNo account found.\n";
        cout << "Please create an account first.\n";

        return false;
    }

    string loginValue;
    string password;

    cin.ignore(numeric_limits<streamsize>::max(), '\n');

    cout << "\n====================================\n";
    cout << "          JEEVAN_MART LOGIN\n";
    cout << "====================================\n";

    cout << "Email or Phone: ";
    getline(cin, loginValue);

    cout << "Password: ";
    getline(cin, password);

    if (
        (loginValue == user.email ||
         loginValue == user.phone)
        &&
        password == user.password
    ) {

        cout << "\nLogin successful! 🎉\n";
        cout << "Welcome, " << user.name << "!\n";

        return true;
    }

    cout << "\nIncorrect email/phone or password.\n";

    return false;
}


/* =========================
   DISPLAY PRODUCTS
========================= */

void displayProducts(vector<Product> list = products) {

    cout << "\n============================================================\n";
    cout << "                    JEEVAN_MART PRODUCTS\n";
    cout << "============================================================\n";

    if (list.empty()) {

        cout << "No products found.\n";
        return;
    }

    for (const auto& p : list) {

        cout << "\nID       : " << p.id;
        cout << "\nProduct  : " << p.name;
        cout << "\nCategory : " << p.category;
        cout << "\nPrice    : ₹" << fixed << setprecision(2) << p.price;
        cout << "\nMRP      : ₹" << p.oldPrice;
        cout << "\nRating   : ⭐ " << p.rating;

        int discount =
            static_cast<int>(
                ((p.oldPrice - p.price) / p.oldPrice) * 100
            );

        cout << "\nDiscount : " << discount << "% OFF";

        cout << "\n----------------------------------------\n";
    }
}


/* =========================
   SEARCH
========================= */

void searchProducts() {

    cin.ignore(numeric_limits<streamsize>::max(), '\n');

    string query;

    cout << "\nEnter product name or category: ";
    getline(cin, query);

    transform(
        query.begin(),
        query.end(),
        query.begin(),
        ::tolower
    );

    vector<Product> results;

    for (const auto& p : products) {

        string name = p.name;
        string category = p.category;

        transform(
            name.begin(),
            name.end(),
            name.begin(),
            ::tolower
        );

        if (
            name.find(query) != string::npos ||
            category.find(query) != string::npos
        ) {

            results.push_back(p);
        }
    }

    displayProducts(results);
}


/* =========================
   CATEGORY
========================= */

void filterCategory() {

    cin.ignore(numeric_limits<streamsize>::max(), '\n');

    string category;

    cout << "\nEnter category:\n";
    cout << "electronics\n";
    cout << "fashion\n";
    cout << "home\n";
    cout << "beauty\n";
    cout << "grocery\n";
    cout << "sports\n";
    cout << "toys\n";

    cout << "\nCategory: ";
    getline(cin, category);

    transform(
        category.begin(),
        category.end(),
        category.begin(),
        ::tolower
    );

    vector<Product> results;

    for (const auto& p : products) {

        if (p.category == category) {
            results.push_back(p);
        }
    }

    displayProducts(results);
}


/* =========================
   FIND PRODUCT
========================= */

Product* findProduct(int id) {

    for (auto& p : products) {

        if (p.id == id) {
            return &p;
        }
    }

    return nullptr;
}


/* =========================
   ADD TO CART
========================= */

void addToCart() {

    int id;

    cout << "\nEnter product ID: ";
    cin >> id;

    Product* product = findProduct(id);

    if (product == nullptr) {

        cout << "\nProduct not found.\n";
        return;
    }

    for (auto& item : cart) {

        if (item.product.id == id) {

            item.quantity++;

            cout << "\nProduct quantity increased.\n";

            return;
        }
    }

    cart.push_back({
        *product,
        1
    });

    cout << "\n";
    cout << product->name;
    cout << " added to cart! 🛒\n";
}


/* =========================
   VIEW CART
========================= */

void viewCart() {

    cout << "\n====================================\n";
    cout << "             MY CART 🛒\n";
    cout << "====================================\n";

    if (cart.empty()) {

        cout << "Your cart is empty.\n";
        return;
    }

    double total = 0;

    for (const auto& item : cart) {

        double itemTotal =
            item.product.price * item.quantity;

        cout << "\nProduct : "
             << item.product.name;

        cout << "\nPrice   : ₹"
             << item.product.price;

        cout << "\nQuantity: "
             << item.quantity;

        cout << "\nSubtotal: ₹"
             << itemTotal;

        cout << "\n------------------------------------\n";

        total += itemTotal;
    }

    cout << "\nTOTAL: ₹"
         << fixed
         << setprecision(2)
         << total
         << "\n";
}


/* =========================
   CHANGE QUANTITY
========================= */

void changeQuantity() {

    if (cart.empty()) {

        cout << "\nYour cart is empty.\n";
        return;
    }

    int id;
    int quantity;

    cout << "\nEnter product ID: ";
    cin >> id;

    for (auto& item : cart) {

        if (item.product.id == id) {

            cout << "Enter new quantity: ";
            cin >> quantity;

            if (quantity <= 0) {

                cout << "\nInvalid quantity.\n";
                return;
            }

            item.quantity = quantity;

            cout << "\nQuantity updated.\n";

            return;
        }
    }

    cout << "\nProduct not found in cart.\n";
}


/* =========================
   REMOVE FROM CART
========================= */

void removeFromCart() {

    if (cart.empty()) {

        cout << "\nYour cart is empty.\n";
        return;
    }

    int id;

    cout << "\nEnter product ID to remove: ";
    cin >> id;

    for (
        auto it = cart.begin();
        it != cart.end();
        ++it
    ) {

        if (it->product.id == id) {

            cart.erase(it);

            cout << "\nProduct removed from cart.\n";

            return;
        }
    }

    cout << "\nProduct not found.\n";
}


/* =========================
   CHECKOUT
========================= */

void checkout() {

    if (cart.empty()) {

        cout << "\nYour cart is empty!\n";
        return;
    }

    double total = 0;

    for (const auto& item : cart) {

        total +=
            item.product.price *
            item.quantity;
    }

    cout << "\n====================================\n";
    cout << "            ORDER SUMMARY\n";
    cout << "====================================\n";

    cout << "Customer : "
         << user.name
         << "\n";

    cout << "Total    : ₹"
         << fixed
         << setprecision(2)
         << total
         << "\n";

    cout << "\nThank you for shopping with\n";
    cout << "Jeevan_mart! 🎉\n";

    cout << "\nOrder placed successfully!\n";

    cart.clear();
}


